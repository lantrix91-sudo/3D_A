# Секрет Django/JWT: сгенерируйте локально минимум 50 случайных символов.
SECRET_KEY=
# true только локально; в коде по умолчанию false.
DEBUG=true
# IP компьютера в локальной сети; добавляется в hosts/CSRF только при DEBUG=true.
LOCAL_IP=
# Backend-хосты через запятую, без схемы и порта; Railway: свой домен + healthcheck.railway.app.
ALLOWED_HOSTS=localhost,127.0.0.1
# Доверенные origins для CSRF, со схемой; в production — HTTPS-домены.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5174,http://localhost:5175
# Origins браузерного frontend, без завершающего слеша.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175
# Локально SQLite; Railway: ссылка на DATABASE_URL сервиса PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3
# Для DEBUG=false обязателен URL Redis; локально пусто = InMemory.
REDIS_URL=
# JSON device_id -> ключ для симулятора (simulator/simulate.py). Backend ключи из env не принимает:
# ключи создаются в админке или командой issue_device_key и хранятся только как хэш.
DEVICE_API_KEYS={}
# Секунд без данных до статуса offline; тип оборудования может переопределить.
STATUS_OFFLINE_SECONDS=180
# Интервал фоновой проверки offline в start.sh, секунды.
STATUS_CHECK_INTERVAL=15
# Минимальный интервал записи неизменного значения в историю, секунды.
READING_MIN_INTERVAL_SECONDS=30
# Приём POST /api/v1/readings/ без X-Device-Key. Только для разработки, при DEBUG=false запрещён.
ALLOW_UNAUTHENTICATED_DEVICES=false
# Локальное media-хранилище; путь от backend/ или абсолютный.
MEDIA_ROOT=media
# Непустой bucket включает S3-совместимое хранилище вместо MEDIA_ROOT.
AWS_STORAGE_BUCKET_NAME=
# Ключ доступа S3/R2 (только backend; в AWS можно использовать роль IAM).
AWS_ACCESS_KEY_ID=
# Секрет доступа S3/R2; никогда не переносите во frontend.
AWS_SECRET_ACCESS_KEY=
# Endpoint R2: https://<account-id>.r2.cloudflarestorage.com; для AWS S3 можно не задавать.
AWS_S3_ENDPOINT_URL=
# Регион AWS; для R2 задайте auto.
AWS_S3_REGION_NAME=
# Необязательный публичный CDN-домен без схемы/слеша; пусто = подписанные URL bucket.
AWS_S3_CUSTOM_DOMAIN=
# Подпись URL для приватного bucket. Для публичного CDN используйте false.
AWS_QUERYSTRING_AUTH=true
# Срок подписанной ссылки в секундах; после истечения обновите план.
AWS_QUERYSTRING_EXPIRE=3600
# Часовой пояс предприятия.
TIME_ZONE=Asia/Qyzylorda
# Время жизни access JWT в минутах.
JWT_ACCESS_MINUTES=15
# Время жизни refresh JWT в днях.
JWT_REFRESH_DAYS=7
# Порт Daphne; Railway задаёт автоматически, локально start.sh использует 8000.
PORT=8000
# Читать backend/.env; в контейнере уже false. Переменные процесса имеют приоритет.
DJANGO_READ_DOT_ENV=true
# HTTPS redirect/HSTS зависят от DEBUG; раскомментируйте лишь при необходимости.
# SECURE_SSL_REDIRECT=true
# HSTS max-age в секундах; production по умолчанию 31536000, локально 0.
# SECURE_HSTS_SECONDS=31536000
# Распространять HSTS на поддомены; включайте, только если все используют HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# HSTS preload — по умолчанию выключен.
SECURE_HSTS_PRELOAD=false
# Только для явного локального create_demo_users; в production не требуется.
DEMO_USER_PASSWORD=
# Имя администратора для разового createsuperuser --noinput.
DJANGO_SUPERUSER_USERNAME=
# Email администратора для разовой команды.
DJANGO_SUPERUSER_EMAIL=
# Пароль администратора для разовой команды; удалите переменную после выполнения.
DJANGO_SUPERUSER_PASSWORD=
