# Настройки нового фронтенда. Скопируйте этот файл в .env (.env в Git не попадает).
# Личные настройки разработки можно держать в .env.local: он важнее .env и тоже не попадает в Git.
# Все переменные VITE_* публичны и встраиваются при сборке: секретов здесь быть не должно.

# Адрес Django для npm run dev: на него Vite пересылает /api, /media, /admin, /static и /ws.
VITE_BACKEND_URL=http://127.0.0.1:8000
# Публичный адрес бэкенда без /api/v1 и завершающего слеша. Используется только при npm run build.
# При npm run dev запросы идут через Vite proxy (см. VITE_BACKEND_URL выше), поэтому оставьте пустым.
VITE_API_URL=
# Публичный адрес WebSocket (в production: wss://<домен бэкенда>).
VITE_WS_URL=/ws/
